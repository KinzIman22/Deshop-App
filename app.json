{
  "expo": {
    "name": "deshop-app",
    "slug": "deshop-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.deshopapp"
    },
    "android": {
      "package": "com.anonymous.deshopapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}